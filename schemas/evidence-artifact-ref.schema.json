{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/codex-harness/evidence-artifact-ref.schema.json",
  "title": "codex-harness Evidence Artifact Ref",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "artifact_id",
    "sha256",
    "path",
    "kind",
    "media_type",
    "size_bytes",
    "sensitivity",
    "redaction_status",
    "exportable"
  ],
  "properties": {
    "artifact_id": { "type": "string" },
    "sha256": { "type": "string" },
    "path": { "type": "string" },
    "kind": { "type": "string" },
    "media_type": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "producer_command": { "type": "string" },
    "sensitivity": { "enum": ["public", "local", "sensitive"] },
    "redaction_status": { "enum": ["not_redacted", "redacted", "not_applicable"] },
    "exportable": { "type": "boolean" }
  }
}
