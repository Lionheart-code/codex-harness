{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "ProofEligibilitySnapshotV1", "type": "object",
  "required": ["schema_version", "record_kind", "snapshot_id", "run_instance_id", "task_artifact_id", "immutable_base", "activation_source_head", "contract_marker", "component_refs", "procedure_requirements", "stage_requirements", "bootstrap_eligibility", "created_at"],
  "properties": {
    "schema_version": { "const": "phase-23.9.proof-eligibility-snapshot.v1" }, "record_kind": { "const": "proof_eligibility_snapshot" },
    "snapshot_id": { "$ref": "#/$defs/sha256" }, "run_instance_id": { "$ref": "#/$defs/nonempty" },
    "task_artifact_id": { "$ref": "#/$defs/sha256" }, "immutable_base": { "$ref": "#/$defs/gitSha" },
    "activation_source_head": { "$ref": "#/$defs/gitSha" }, "contract_marker": { "$ref": "#/$defs/sha256" },
    "component_refs": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/component" } },
    "procedure_requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/procedureRequirement" } },
    "stage_requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stageRequirement" } },
    "bootstrap_eligibility": { "enum": ["eligible", "bootstrap_ineligible", "legacy_gap_unaccepted"] },
    "created_at": { "type": "string", "format": "date-time" }
  }, "additionalProperties": false,
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "component": { "type": "object", "required": ["component_kind", "path", "content_hash"], "properties": { "component_kind": { "enum": ["procedure_registry", "execution_policy", "stage_map", "predicate_contract"] }, "path": { "$ref": "#/$defs/nonempty" }, "content_hash": { "$ref": "#/$defs/sha256" } }, "additionalProperties": false },
    "basis": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonempty" } },
    "procedureRequirement": { "type": "object", "required": ["procedure_id", "procedure_occurrence", "requirement_class", "predicate_id", "predicate_result", "basis_ref_ids"], "properties": { "procedure_id": { "$ref": "#/$defs/nonempty" }, "procedure_occurrence": { "enum": ["single", "planning_candidate", "planning_closure"] }, "requirement_class": { "enum": ["always", "required_if"] }, "predicate_id": { "$ref": "#/$defs/nonempty" }, "predicate_result": { "enum": ["true", "false", "deferred"] }, "basis_ref_ids": { "$ref": "#/$defs/basis" } }, "additionalProperties": false },
    "stageRequirement": { "type": "object", "required": ["stage_id", "requirement_class", "predicate_id", "predicate_result", "basis_ref_ids"], "properties": { "stage_id": { "$ref": "#/$defs/nonempty" }, "requirement_class": { "enum": ["always", "required_if"] }, "predicate_id": { "$ref": "#/$defs/nonempty" }, "predicate_result": { "enum": ["true", "false", "deferred"] }, "basis_ref_ids": { "$ref": "#/$defs/basis" } }, "additionalProperties": false }
  }
}
