{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImplementationReviewViewV1",
  "type": "object",
  "required": ["schema_version", "view_kind", "authority", "run", "plan", "procedure", "context", "delta", "evidence", "route", "transport", "budget", "independence", "claims", "redaction", "truncation", "view_id"],
  "properties": {
    "schema_version": { "const": 1 }, "view_kind": { "const": "implementation_review_view" }, "authority": { "const": "active_run_staging" },
    "run": { "type": "object", "required": ["run_instance_id", "run_id", "phase_id", "task_path", "branch", "immutable_base", "baseline_head", "baseline_tree_hash", "candidate_head", "reviewed_candidate_id", "source_snapshot"], "properties": { "run_instance_id": { "type": "string" }, "run_id": { "type": "string" }, "phase_id": { "type": ["string", "null"] }, "task_path": { "type": "string" }, "branch": { "type": ["string", "null"] }, "immutable_base": { "type": ["string", "null"] }, "baseline_head": { "$ref": "#/$defs/commit" }, "baseline_tree_hash": { "$ref": "#/$defs/commit" }, "candidate_head": { "$ref": "#/$defs/commit" }, "reviewed_candidate_id": { "$ref": "#/$defs/contentId" }, "source_snapshot": { "type": ["string", "null"] } }, "additionalProperties": false },
    "plan": { "type": "object", "required": ["artifact_id", "approval_id", "task_artifact_id", "planning_cohort_id", "required_lens_ids", "lens_artifacts"], "properties": { "artifact_id": { "$ref": "#/$defs/contentId" }, "approval_id": { "type": "string" }, "task_artifact_id": { "type": ["string", "null"] }, "planning_cohort_id": { "type": ["string", "null"] }, "required_lens_ids": { "$ref": "#/$defs/stringArray" }, "lens_artifacts": { "type": "array", "items": { "type": "object", "required": ["procedure_id", "artifact_id", "artifact_content_hash"], "properties": { "procedure_id": { "type": "string" }, "artifact_id": { "$ref": "#/$defs/contentId" }, "artifact_content_hash": { "$ref": "#/$defs/contentId" } }, "additionalProperties": false } } }, "additionalProperties": false },
    "procedure": { "type": "object", "required": ["id", "source_map_ref", "execution_policy_ref", "route_policy_ref", "binding_ref"], "properties": { "id": { "type": "string" }, "source_map_ref": { "type": "string" }, "execution_policy_ref": { "type": "string" }, "route_policy_ref": { "type": "string" }, "binding_ref": { "type": "string" } }, "additionalProperties": false },
    "context": { "type": "object", "required": ["packet_record_id", "core_id", "core_hash", "manifest_id", "manifest_hash", "core", "manifest", "payload_refs"], "properties": { "packet_record_id": { "$ref": "#/$defs/contentId" }, "core_id": { "type": "string", "pattern": "^context-core-[a-f0-9]{64}$" }, "core_hash": { "$ref": "#/$defs/contentId" }, "manifest_id": { "type": "string", "pattern": "^context-manifest-[a-f0-9]{64}$" }, "manifest_hash": { "$ref": "#/$defs/contentId" }, "core": { "$ref": "context-export-view.schema.json#/$defs/contextCore" }, "manifest": { "$ref": "context-export-view.schema.json#/$defs/contextManifest" }, "payload_refs": { "type": "array", "items": { "$ref": "context-export-view.schema.json#/$defs/payloadRef" } } }, "additionalProperties": false },
    "delta": { "type": "object", "required": ["overlay_id", "overlay_hash", "changed_files", "diff_refs", "payload_refs", "changed_authority_surfaces", "changed_architecture_surfaces", "risks", "findings", "verification_refs", "missing_evidence", "escalation_reasons", "canonical_byte_count", "size_budget_bytes"], "properties": { "overlay_id": { "type": "string", "pattern": "^review-delta-[a-f0-9]{64}$" }, "overlay_hash": { "$ref": "#/$defs/contentId" }, "changed_files": { "$ref": "#/$defs/stringArray" }, "diff_refs": { "$ref": "#/$defs/stringArray" }, "payload_refs": { "$ref": "#/$defs/stringArray" }, "changed_authority_surfaces": { "$ref": "#/$defs/stringArray" }, "changed_architecture_surfaces": { "$ref": "#/$defs/stringArray" }, "risks": { "$ref": "#/$defs/stringArray" }, "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }, "verification_refs": { "$ref": "#/$defs/stringArray" }, "missing_evidence": { "$ref": "#/$defs/stringArray" }, "escalation_reasons": { "$ref": "#/$defs/stringArray" }, "canonical_byte_count": { "type": "integer", "minimum": 0 }, "size_budget_bytes": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "evidence": { "type": "object", "required": ["verification_refs", "prior_review_refs", "routing_refs", "proof"], "properties": { "verification_refs": { "$ref": "#/$defs/stringArray" }, "prior_review_refs": { "$ref": "#/$defs/stringArray" }, "routing_refs": { "$ref": "#/$defs/stringArray" }, "proof": { "$ref": "#/$defs/proofAvailability" } }, "additionalProperties": false },
    "route": { "type": "object", "required": ["decision_id", "route_class", "policy_version", "binding_version", "binding_profile_id", "review_tier", "risk_classes", "required_semantic_reviews"], "properties": { "decision_id": { "type": "string" }, "route_class": { "type": "string" }, "policy_version": { "type": "string" }, "binding_version": { "type": "string" }, "binding_profile_id": { "type": "string" }, "review_tier": { "type": "string" }, "risk_classes": { "$ref": "#/$defs/stringArray" }, "required_semantic_reviews": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "transport": { "type": "object", "required": ["context_mode", "context_reuse", "retention_class", "redaction_status", "retrieval", "usage_ref"], "properties": { "context_mode": { "type": "string" }, "context_reuse": { "type": "string" }, "retention_class": { "type": "string" }, "redaction_status": { "type": "string" }, "retrieval": { "const": "read_only_exact_payload_reconstruction" }, "usage_ref": { "type": ["string", "null"] } }, "additionalProperties": false },
    "budget": { "type": "object", "required": ["class", "core_bytes", "core_limit_bytes", "delta_bytes", "delta_limit_bytes"], "properties": { "class": { "type": "string" }, "core_bytes": { "type": "integer", "minimum": 0 }, "core_limit_bytes": { "type": "integer", "minimum": 1 }, "delta_bytes": { "type": "integer", "minimum": 0 }, "delta_limit_bytes": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "independence": { "type": "object", "required": ["required", "mode", "approved_attempt_id", "builder_transcript_authority"], "properties": { "required": { "const": true }, "mode": { "type": "string" }, "approved_attempt_id": { "type": "string" }, "builder_transcript_authority": { "const": false } }, "additionalProperties": false },
    "claims": { "type": "array", "items": { "type": "object", "required": ["claim", "status", "evidence_refs"], "properties": { "claim": { "type": "string" }, "status": { "enum": ["evidence", "inference", "missing"] }, "evidence_refs": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false } },
    "redaction": { "type": "object", "required": ["applied_before_serialization", "raw_payloads_exported", "source_redactions"], "properties": { "applied_before_serialization": { "const": true }, "raw_payloads_exported": { "const": false }, "source_redactions": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "truncation": { "type": "object", "required": ["applied", "omitted_optional_count", "reasons"], "properties": { "applied": { "type": "boolean" }, "omitted_optional_count": { "type": "integer", "minimum": 0 }, "reasons": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "view_id": { "$ref": "#/$defs/contentId" }
  },
  "$defs": { "contentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "stringArray": { "type": "array", "items": { "type": "string" } }, "finding": { "type": "object", "required": ["finding_id", "disposition"], "properties": { "finding_id": { "type": "string" }, "disposition": { "enum": ["open", "claimed_fixed", "closed", "superseded"] } }, "additionalProperties": false }, "proofAvailability": { "type": "object", "required": ["status", "refs", "acceptance", "gap_refs", "reason"], "properties": { "status": { "enum": ["recorded", "not_applicable", "missing"] }, "refs": { "$ref": "#/$defs/stringArray" }, "acceptance": { "enum": ["accepted", "not_applicable", "missing"] }, "gap_refs": { "$ref": "#/$defs/stringArray" }, "reason": { "type": "string" } }, "additionalProperties": false } },
  "additionalProperties": false
}
