{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewAttemptEventV1",
  "type": "object",
  "required": ["schema_version", "event_id", "attempt_id", "state", "recorded_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "$ref": "#/$defs/sha256" },
    "attempt_id": { "$ref": "#/$defs/sha256" },
    "state": {
      "enum": ["claimed", "started", "terminal_success", "terminal_failure"]
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "raw_startup_observation": {
      "oneOf": [
        { "$ref": "#/$defs/cliPreamble" },
        { "$ref": "#/$defs/turnContext" }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "startupCommon": {
      "type": "object",
      "required": [
        "schema_version", "source_kind", "session_id", "raw_bytes", "raw_sha256"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "raw_bytes": { "type": "string", "minLength": 1 },
        "raw_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cliPreamble": {
      "allOf": [
        { "$ref": "#/$defs/startupCommon" },
        {
          "type": "object",
          "required": ["source_kind", "byte_start", "byte_end"],
          "properties": {
            "source_kind": { "const": "codex_cli_startup_preamble_v1" },
            "byte_start": { "type": "integer", "minimum": 0 },
            "byte_end": { "type": "integer", "minimum": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "turnContext": {
      "allOf": [
        { "$ref": "#/$defs/startupCommon" },
        {
          "type": "object",
          "required": ["source_kind", "turn_ordinal", "context_locator"],
          "properties": {
            "source_kind": { "const": "codex_turn_context_v1" },
            "turn_ordinal": { "type": "integer", "minimum": 0 },
            "context_locator": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
