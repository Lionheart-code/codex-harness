{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codex-harness runtime run",
  "type": "object",
  "required": [
    "schema_version",
    "producer_command",
    "run_id",
    "task_path",
    "created_at",
    "updated_at",
    "repository",
    "phase_runs",
    "steps",
    "artifacts",
    "evidence",
    "findings",
    "decisions",
    "approvals",
    "command_results",
    "verification_results",
    "review_results",
    "required_gates",
    "remote_checks",
    "closeout_receipts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "producer_command": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_path": { "type": "string", "minLength": 1 },
    "active_task_path": { "type": "string", "minLength": 1 },
    "phase_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["running", "ready", "blocked", "closed"] },
    "run_mode": { "enum": ["normal", "bootstrap"] },
    "lifecycle_status": { "enum": ["active", "blocked", "closed", "harvested", "discarded"] },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "discard_reason": { "type": "string" },
    "manual_override_reason": { "type": "string" },
    "harvested_at": { "type": "string" },
    "source_snapshot": { "type": "string" },
    "source_staging_db_path": { "type": "string" },
    "implementation_baseline_head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "final_reviewed_source_head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "delivered_source_head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "delivery_source_relationship": {
      "type": "object",
      "required": [
        "schema_version", "relationship", "delivered_source_head", "final_reviewed_source_head",
        "delivered_tree_hash", "final_reviewed_tree_hash", "ancestry", "delivery_fact_id"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "relationship": { "enum": ["identity", "merge_contains_exact_tree"] },
        "delivered_source_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "final_reviewed_source_head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "delivered_tree_hash": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "final_reviewed_tree_hash": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "ancestry": { "enum": ["same_commit", "ancestor"] },
        "delivery_fact_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "implementation_baseline_binding": {
      "type": "object",
      "required": [
        "schema_version",
        "approval_id",
        "plan_artifact_hash",
        "planning_review_source_head",
        "owner_authority_diff_hash",
        "implementation_baseline_head",
        "implementation_baseline_tree_hash",
        "expected_tree_hash",
        "bound_at"
      ],
      "properties": {
        "schema_version": { "enum": [1, 2] },
        "approval_id": { "type": "string", "minLength": 1 },
        "plan_artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "plan_review_artifact_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "planning_review_source_head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "authority_transition": {
          "enum": ["reviewed_source", "owner_authorized_overlay"]
        },
        "owner_authority_diff_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "implementation_baseline_head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "implementation_baseline_tree_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "expected_tree_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "bound_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "review_launch_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "attempt_id", "attempt_marker", "procedure_id", "owner_token_hash", "created_at", "request_artifact_hash", "expected_output_path", "timeout_seconds", "stale_after_seconds", "termination_policy"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "attempt_id": { "type": "string", "minLength": 1 },
          "attempt_marker": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "procedure_id": { "enum": ["plan-review", "architecture-review", "db-storage-review", "implementation-review", "fix-pass-review"] },
          "owner_token_hash": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "minLength": 1 },
          "request_artifact_hash": { "type": "string", "minLength": 1 },
          "expected_output_path": { "type": "string", "minLength": 1 },
          "timeout_seconds": { "type": "integer", "minimum": 1 },
          "stale_after_seconds": { "type": "integer", "minimum": 1 },
          "termination_policy": { "const": "terminal_completion_only" },
          "pid": { "type": "integer", "minimum": 1 },
          "progress_unknown_at": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "review_routing_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_kind", "record_id", "created_at", "status", "summary", "payload"],
        "properties": {
          "record_kind": {"enum": ["review_invocation", "review_replay_packet", "routing_evaluation", "routing_decision", "routing_policy_application", "prepared_successor_cleanup"]},
          "record_id": {"type": "string", "minLength": 1},
          "created_at": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "payload": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "repository": {
      "type": "object",
      "required": ["root_path", "dirty"],
      "properties": {
        "root_path": { "type": "string", "minLength": 1 },
        "project_root": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "head_sha": { "type": "string" },
        "task_worktree_path": { "type": "string" },
        "dirty": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "phase_runs": { "type": "array", "items": { "type": "object" } },
    "steps": { "type": "array", "items": { "type": "object" } },
    "artifacts": { "type": "array", "items": { "type": "object" } },
    "evidence": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "object" } },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "approvals": { "type": "array", "items": { "type": "object" } },
    "command_results": { "type": "array", "items": { "type": "object" } },
    "verification_results": { "type": "array", "items": { "type": "object" } },
    "review_results": { "type": "array", "items": { "type": "object" } },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate_id", "name", "required", "status"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["pass", "failed", "skipped", "missing", "unknown"] },
          "explanation": { "type": "string" },
          "check_result_id": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "remote_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_result_id", "gate_id", "name", "status", "required", "recorded_at", "ci_run"],
        "properties": {
          "check_result_id": { "type": "string", "minLength": 1 },
          "gate_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "failed", "skipped", "missing", "unknown"] },
          "required": { "type": "boolean" },
          "recorded_at": { "type": "string", "minLength": 1 },
          "ci_run": {
            "type": "object",
            "required": ["provider"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "run_id": { "type": "string" },
              "url": { "type": "string" },
              "metadata": { "type": "object" }
            },
            "additionalProperties": true
          },
          "explanation": { "type": "string" },
          "metadata": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "delivery_facts": { "type": "array", "items": { "$ref": "./delivery-fact.schema.json" } },
    "closeout_receipts": { "type": "array", "items": { "type": "object" } }
  },
  "anyOf": [
    {
      "required": ["status"]
    },
    {
      "required": ["run_mode", "lifecycle_status", "delivery_facts"],
      "properties": {
        "repository": {
          "required": ["root_path", "project_root", "dirty"]
        }
      }
    }
  ],
  "additionalProperties": true
}
