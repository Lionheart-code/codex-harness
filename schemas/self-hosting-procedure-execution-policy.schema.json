{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self-hosting procedure execution policy",
  "type": "object",
  "required": ["schema_version", "producer_command", "contract_version", "policy_id", "procedures"],
  "properties": {
    "schema_version": {"const": 1},
    "producer_command": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "procedures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
      "required": ["procedure_id", "canonical_contract_ref", "semantic_class", "deterministic_prechecks", "semantic_residual", "minimum_route", "escalation_triggers", "independence", "context_transport", "automatic_launch", "deterministic_completion_supported", "required_output_contract", "required_evidence_contract"],
        "properties": {
        "procedure_id": {"type": "string", "minLength": 1},
        "canonical_contract_ref": {"type": "string", "pattern": "^skills/self-hosting/[a-z0-9-]+/SKILL\\.md$"},
          "semantic_class": {"enum": ["deterministic_only", "semantic_optional", "semantic_required"]},
          "deterministic_prechecks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "semantic_residual": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "minimum_route": {"enum": ["deterministic_no_model", "balanced_routine", "complex_judgment", "critical_independent"]},
          "escalation_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "independence": {"enum": ["none", "same_role", "independent"]},
          "context_transport": {"enum": ["fresh_packet", "resume_same_role", "packet_plus_retrieval", "fresh_independent_delta"]},
          "automatic_launch": {"type": "boolean"},
          "deterministic_completion_supported": {"type": "boolean"},
          "required_output_contract": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_evidence_contract": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "direct_artifact_required": {"type": "boolean"},
          "nested_review_launch_forbidden": {"type": "boolean"},
          "review_launch": {
            "type": "object",
            "required": ["timeout_seconds", "stale_after_seconds", "timeout_override", "stale_after_override", "termination_policy"],
            "properties": {
              "timeout_seconds": {"type": "integer", "minimum": 1},
              "stale_after_seconds": {"type": "integer", "minimum": 1},
              "timeout_override": {
                "type": "object",
                "required": ["minimum_seconds", "maximum_seconds"],
                "properties": {
                  "minimum_seconds": {"type": "integer", "minimum": 1},
                  "maximum_seconds": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              },
              "stale_after_override": {
                "type": "object",
                "required": ["minimum_seconds", "maximum_seconds"],
                "properties": {
                  "minimum_seconds": {"type": "integer", "minimum": 1},
                  "maximum_seconds": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              },
              "termination_policy": {"const": "terminal_completion_only"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
