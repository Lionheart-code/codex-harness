{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AcceptedContextViewV1",
  "type": "object",
  "required": ["schema_version", "view_kind", "authority", "run_instance_id", "packet_record_id", "acceptance", "context", "ordered_payload_refs", "claims", "transport", "retrieval", "redaction", "truncation", "view_id"],
  "properties": {
    "schema_version": { "const": 1 }, "view_kind": { "const": "accepted_context_view" }, "authority": { "const": "accepted_project_memory" },
    "run_instance_id": { "type": "string", "minLength": 1 }, "packet_record_id": { "$ref": "#/$defs/contentId" },
    "acceptance": { "type": "object", "required": ["harvest_id", "status", "project_run_id"], "properties": { "harvest_id": { "type": "string" }, "status": { "const": "promoted" }, "project_run_id": { "type": "string" } }, "additionalProperties": false },
    "context": { "type": "object", "required": ["core_id", "core_hash", "manifest_id", "manifest_hash", "overlay_id", "core", "manifest"], "properties": { "core_id": { "type": "string", "pattern": "^context-core-[a-f0-9]{64}$" }, "core_hash": { "$ref": "#/$defs/contentId" }, "manifest_id": { "type": "string", "pattern": "^context-manifest-[a-f0-9]{64}$" }, "manifest_hash": { "$ref": "#/$defs/contentId" }, "overlay_id": { "type": ["string", "null"] }, "core": { "$ref": "#/$defs/contextCore" }, "manifest": { "$ref": "#/$defs/contextManifest" } }, "additionalProperties": false },
    "ordered_payload_refs": { "type": "array", "items": { "$ref": "#/$defs/payloadRef" } },
    "claims": { "type": "array", "items": { "type": "object", "required": ["claim", "status", "evidence_refs"], "properties": { "claim": { "type": "string" }, "status": { "enum": ["evidence", "inference", "missing"] }, "evidence_refs": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false } },
    "transport": { "type": "object", "required": ["mode", "reuse", "procedure_id"], "properties": { "mode": {}, "reuse": {}, "procedure_id": { "type": ["string", "null"] } }, "additionalProperties": false },
    "retrieval": { "type": "object", "required": ["mode", "capabilities", "canonical_bytes", "mandatory_blocks_present", "source_manifest_omissions"], "properties": { "mode": { "const": "read_only_exact_payload_reconstruction" }, "capabilities": { "$ref": "#/$defs/stringArray" }, "canonical_bytes": { "type": "object", "required": ["core", "manifest"], "properties": { "core": { "type": "integer", "minimum": 0 }, "manifest": { "type": "integer", "minimum": 0 } }, "additionalProperties": false }, "mandatory_blocks_present": { "$ref": "#/$defs/stringArray" }, "source_manifest_omissions": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "redaction": { "type": "object", "required": ["applied_before_serialization", "raw_payloads_exported", "source_redactions"], "properties": { "applied_before_serialization": { "const": true }, "raw_payloads_exported": { "const": false }, "source_redactions": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "truncation": { "type": "object", "required": ["applied", "omitted_optional_count", "reasons"], "properties": { "applied": { "type": "boolean" }, "omitted_optional_count": { "type": "integer", "minimum": 0 }, "reasons": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "view_id": { "$ref": "#/$defs/contentId" }
  },
  "$defs": {
    "contentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "sourceRef": { "type": "object", "required": ["path", "content_hash", "byte_count", "required", "retrieval_mode"], "properties": { "path": { "type": "string", "minLength": 1 }, "content_hash": { "$ref": "#/$defs/contentId" }, "byte_count": { "type": "integer", "minimum": 0 }, "required": { "type": "boolean" }, "retrieval_mode": { "enum": ["inline", "read_only_reference"] } }, "additionalProperties": false },
    "contextCore": { "type": "object", "required": ["task_id", "task_pointer_ref", "task_contract_ref", "approved_plan_ref", "procedure_contract_refs", "review_tier", "changed_surface_classes", "risk_classes", "run_id", "run_instance_id", "branch", "worktree_ref", "source_snapshot", "immutable_base", "architectural_invariants", "non_goals", "acceptance_refs", "verification_refs", "source_provenance", "size_budget_bytes", "redactions", "truncations", "context_core_id", "content_hash", "canonical_byte_count"], "properties": { "task_id": { "type": "string" }, "task_pointer_ref": { "type": "string" }, "task_contract_ref": { "type": "string" }, "approved_plan_ref": { "type": "string" }, "procedure_contract_refs": { "$ref": "#/$defs/stringArray" }, "review_tier": { "type": "string" }, "changed_surface_classes": { "$ref": "#/$defs/stringArray" }, "risk_classes": { "$ref": "#/$defs/stringArray" }, "run_id": { "type": "string" }, "run_instance_id": { "type": "string" }, "branch": { "type": "string" }, "worktree_ref": { "type": "string" }, "source_snapshot": { "type": "string" }, "immutable_base": { "type": "string" }, "architectural_invariants": { "$ref": "#/$defs/stringArray" }, "non_goals": { "$ref": "#/$defs/stringArray" }, "acceptance_refs": { "$ref": "#/$defs/stringArray" }, "verification_refs": { "$ref": "#/$defs/stringArray" }, "source_provenance": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }, "size_budget_bytes": { "type": "integer", "minimum": 1 }, "redactions": { "$ref": "#/$defs/stringArray" }, "truncations": { "$ref": "#/$defs/stringArray" }, "context_core_id": { "type": "string", "pattern": "^context-core-[a-f0-9]{64}$" }, "content_hash": { "$ref": "#/$defs/contentId" }, "canonical_byte_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "contextManifest": { "type": "object", "required": ["context_manifest_id", "context_core_id", "ordered_sources", "mandatory_blocks_present", "omissions", "redactions", "truncations", "retrieval_capabilities", "content_hash", "canonical_byte_count"], "properties": { "context_manifest_id": { "type": "string", "pattern": "^context-manifest-[a-f0-9]{64}$" }, "context_core_id": { "type": "string", "pattern": "^context-core-[a-f0-9]{64}$" }, "ordered_sources": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } }, "mandatory_blocks_present": { "$ref": "#/$defs/stringArray" }, "omissions": { "$ref": "#/$defs/stringArray" }, "redactions": { "$ref": "#/$defs/stringArray" }, "truncations": { "$ref": "#/$defs/stringArray" }, "retrieval_capabilities": { "$ref": "#/$defs/stringArray" }, "content_hash": { "$ref": "#/$defs/contentId" }, "canonical_byte_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "payloadRef": { "type": "object", "required": ["payload_id", "kind", "content_hash", "raw_size_bytes", "redaction_status", "retention_class"], "properties": { "payload_id": { "type": "string" }, "kind": { "type": "string" }, "content_hash": { "$ref": "#/$defs/contentId" }, "raw_size_bytes": { "type": "integer", "minimum": 0 }, "redaction_status": { "type": "string" }, "retention_class": { "type": "string" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
