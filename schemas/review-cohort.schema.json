{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewCohortV1",
  "type": "object",
  "required": [
    "schema_version", "record_kind", "record_id", "content_hash", "run_instance_id",
    "run_id", "task_artifact_id", "immutable_base", "planning_review_source_head",
    "anchor_plan_sha", "output_contract_refs", "profile_id", "bundle_kind",
    "predecessor_cohort_id", "required_lens_ids", "carried_lens_refs",
    "context_core_hash", "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "record_kind": { "const": "review_cohort" },
    "record_id": { "$ref": "#/$defs/sha256" },
    "content_hash": { "$ref": "#/$defs/sha256" },
    "run_instance_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "task_artifact_id": { "$ref": "#/$defs/sha256" },
    "immutable_base": { "$ref": "#/$defs/gitSha" },
    "planning_review_source_head": { "$ref": "#/$defs/gitSha" },
    "anchor_plan_sha": { "$ref": "#/$defs/sha256" },
    "output_contract_refs": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "$ref": "#/$defs/outputContract" }
    },
    "profile_id": { "type": "string", "minLength": 1 },
    "bundle_kind": { "enum": ["candidate", "closure"] },
    "predecessor_cohort_id": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "required_lens_ids": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": ["plan-review", "architecture-review", "db-storage-review"] } },
    "carried_lens_refs": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/carryForward" } },
    "context_core_hash": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    { "if": { "properties": { "bundle_kind": { "const": "candidate" } }, "required": ["bundle_kind"] },
      "then": { "properties": { "required_lens_ids": { "const": ["plan-review", "architecture-review", "db-storage-review"] }, "predecessor_cohort_id": { "type": "null" }, "carried_lens_refs": { "maxItems": 0 }, "output_contract_refs": { "minItems": 3, "maxItems": 3 } } },
      "else": { "properties": { "predecessor_cohort_id": { "$ref": "#/$defs/sha256" } } } }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "carryForward": {
      "type": "object",
      "required": ["procedure_id", "source_cohort_id", "source_plan_sha", "source_artifact_id", "source_artifact_hash", "target_plan_sha", "unchanged_decision_ids", "unchanged_trace_ids", "unchanged_contract_surface_ids", "output_contract_id", "validation_hash"],
      "properties": {
        "procedure_id": { "enum": ["plan-review", "architecture-review", "db-storage-review"] },
        "source_cohort_id": { "$ref": "#/$defs/sha256" }, "source_plan_sha": { "$ref": "#/$defs/sha256" },
        "source_artifact_id": { "$ref": "#/$defs/sha256" }, "source_artifact_hash": { "$ref": "#/$defs/sha256" },
        "target_plan_sha": { "$ref": "#/$defs/sha256" },
        "unchanged_decision_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "unchanged_trace_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "unchanged_contract_surface_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "output_contract_id": { "$ref": "#/$defs/sha256" }, "validation_hash": { "$ref": "#/$defs/sha256" }
      }, "additionalProperties": false
    },
    "outputContract": {
      "type": "object",
      "required": ["procedure_id", "registry_contract_version", "skill_path", "skill_hash", "output_format_path", "output_format_hash", "output_schema_path", "output_schema_hash", "output_contract_id"],
      "properties": {
        "procedure_id": { "enum": ["plan-review", "architecture-review", "db-storage-review"] },
        "registry_contract_version": { "type": "string", "minLength": 1 },
        "skill_path": { "type": "string", "minLength": 1 },
        "skill_hash": { "$ref": "#/$defs/sha256" },
        "output_format_path": { "type": "string", "minLength": 1 },
        "output_format_hash": { "$ref": "#/$defs/sha256" },
        "output_schema_path": { "type": "string", "minLength": 1 },
        "output_schema_hash": { "$ref": "#/$defs/sha256" },
        "output_contract_id": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
