{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoricalEvidenceReportV1",
  "type": "object",
  "required": ["schema_version", "view_kind", "authority", "run", "plan", "claims", "verification", "reviews", "delivery", "remote_checks", "proof", "gaps", "inferences", "unknowns", "routing", "provenance", "delivery_relationship", "closeout", "harvest", "budget", "redaction", "truncation", "view_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "view_kind": { "const": "historical_evidence_report" },
    "authority": { "const": "accepted_project_memory" },
    "run": {
      "type": "object",
      "required": ["run_instance_id", "run_id", "phase_id", "task_path", "lifecycle_status", "source_head", "source_snapshot", "implementation_baseline_head", "final_reviewed_source_head", "delivered_source_head"],
      "properties": {
        "run_instance_id": { "type": "string", "minLength": 1 }, "run_id": { "type": "string", "minLength": 1 },
        "phase_id": { "type": ["string", "null"] }, "task_path": { "type": "string", "minLength": 1 },
        "lifecycle_status": { "const": "harvested" }, "source_head": { "$ref": "#/$defs/nullableCommit" },
        "source_snapshot": { "$ref": "#/$defs/nullableCommit" }, "implementation_baseline_head": { "$ref": "#/$defs/nullableCommit" },
        "final_reviewed_source_head": { "$ref": "#/$defs/nullableCommit" }, "delivered_source_head": { "$ref": "#/$defs/nullableCommit" }
      },
      "additionalProperties": false
    },
    "plan": { "type": "object", "required": ["approval_id", "reviewed_plan_artifact_id", "reviewed_plan_content_hash", "reviewed_evidence_artifact_id"], "properties": { "approval_id": { "type": ["string", "null"] }, "reviewed_plan_artifact_id": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] }, "reviewed_plan_content_hash": { "anyOf": [{ "$ref": "#/$defs/rawHash" }, { "type": "null" }] }, "reviewed_evidence_artifact_id": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] } }, "additionalProperties": false },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "verification": { "type": "array", "items": { "type": "object", "required": ["id", "status", "source", "created_at", "artifact_refs", "commands"], "properties": { "id": { "type": "string" }, "status": { "type": "string" }, "source": { "type": "string" }, "created_at": { "type": "string" }, "artifact_refs": { "$ref": "#/$defs/stringArray" }, "commands": { "type": "array", "items": { "$ref": "#/$defs/command" } } }, "additionalProperties": false } },
    "reviews": { "type": "array", "items": { "type": "object", "required": ["id", "status", "source", "created_at", "disposition", "blockers", "artifact_refs", "procedure_artifact_refs"], "properties": { "id": { "type": "string" }, "status": { "type": "string" }, "source": { "type": "string" }, "created_at": { "type": "string" }, "disposition": { "enum": ["current", "superseded"] }, "blockers": { "$ref": "#/$defs/stringArray" }, "artifact_refs": { "$ref": "#/$defs/stringArray" }, "procedure_artifact_refs": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false } },
    "delivery": { "type": "array", "items": { "$ref": "#/$defs/externalFact" } },
    "remote_checks": { "type": "array", "items": { "$ref": "#/$defs/remoteCheck" } },
    "proof": { "type": "object", "required": ["status", "refs", "acceptance", "gap_refs", "reason"], "properties": { "status": { "enum": ["recorded", "not_applicable", "missing"] }, "refs": { "$ref": "#/$defs/stringArray" }, "acceptance": { "enum": ["accepted", "not_applicable", "missing"] }, "gap_refs": { "$ref": "#/$defs/stringArray" }, "reason": { "type": "string" } }, "additionalProperties": false },
    "gaps": { "$ref": "#/$defs/stringArray" }, "inferences": { "type": "array" }, "unknowns": { "$ref": "#/$defs/stringArray" },
    "routing": { "type": "object", "required": ["refs", "records", "usage_refs"], "properties": { "refs": { "$ref": "#/$defs/stringArray" }, "records": { "type": "array", "items": { "$ref": "#/$defs/routingRecord" } }, "usage_refs": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "provenance": { "$ref": "#/$defs/provenance" },
    "delivery_relationship": { "anyOf": [{ "$ref": "#/$defs/deliveryRelationship" }, { "type": "null" }] },
    "closeout": { "anyOf": [{ "$ref": "#/$defs/closeout" }, { "type": "null" }] },
    "harvest": { "$ref": "#/$defs/harvest" },
    "budget": { "type": "object", "required": ["output_bytes", "limit_bytes"], "properties": { "output_bytes": { "type": "integer", "minimum": 0 }, "limit_bytes": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "redaction": { "$ref": "#/$defs/redaction" }, "truncation": { "$ref": "#/$defs/truncation" },
    "view_id": { "$ref": "#/$defs/contentId" }
  },
  "$defs": {
    "contentId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "rawHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nullableCommit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "claim": { "type": "object", "required": ["claim", "status", "evidence_refs"], "properties": { "claim": { "type": "string" }, "status": { "enum": ["evidence", "inference", "missing", "not_applicable"] }, "evidence_refs": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "externalFact": { "type": "object", "required": ["id", "kind", "source", "status", "recorded_at", "commit_sha", "url", "url_hash", "external_run_id", "external_run_id_hash", "accepted_record_id", "excerpt_payload_ref"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "source": { "type": "string" }, "status": { "type": "string" }, "recorded_at": { "type": "string" }, "commit_sha": { "$ref": "#/$defs/nullableCommit" }, "url": { "type": ["string", "null"] }, "url_hash": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] }, "external_run_id": { "type": ["string", "null"] }, "external_run_id_hash": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] }, "accepted_record_id": { "type": "string", "minLength": 1 }, "excerpt_payload_ref": { "type": ["string", "null"] } }, "additionalProperties": false },
    "command": { "type": "object", "required": ["id", "command", "status", "exit_code", "artifact_refs"], "properties": { "id": { "type": "string" }, "command": { "type": "string" }, "status": { "type": "string" }, "exit_code": { "type": ["integer", "null"] }, "artifact_refs": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "remoteCheck": { "type": "object", "required": ["id", "gate_id", "name", "required", "status", "recorded_at", "provider", "url", "url_hash", "external_run_id", "external_run_id_hash", "commit_sha", "conclusion", "check_conclusions", "accepted_record_id", "evidence_ref", "failure_excerpt", "failure_excerpt_hash", "redaction_status"], "properties": { "id": { "type": "string" }, "gate_id": { "type": "string" }, "name": { "type": "string" }, "required": { "type": "boolean" }, "status": { "type": "string" }, "recorded_at": { "type": "string" }, "provider": { "type": "string" }, "url": { "type": ["string", "null"] }, "url_hash": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] }, "external_run_id": { "type": ["string", "null"] }, "external_run_id_hash": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] }, "commit_sha": { "$ref": "#/$defs/nullableCommit" }, "conclusion": { "type": "string" }, "check_conclusions": { "type": "array", "items": { "type": "object", "required": ["kind", "id", "status"], "properties": { "kind": { "type": "string" }, "id": { "type": "string" }, "status": { "type": "string" } }, "additionalProperties": false } }, "accepted_record_id": { "type": "string", "minLength": 1 }, "evidence_ref": { "type": "string", "minLength": 1 }, "failure_excerpt": { "type": "string" }, "failure_excerpt_hash": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] }, "redaction_status": { "type": "string" } }, "additionalProperties": false },
    "provenance": { "type": "object", "required": ["accepted_record_refs", "delivery_fact_refs", "procedure_artifacts", "payloads", "procedure_contract_refs"], "properties": { "accepted_record_refs": { "$ref": "#/$defs/stringArray" }, "delivery_fact_refs": { "$ref": "#/$defs/stringArray" }, "procedure_artifacts": { "type": "array", "items": { "$ref": "#/$defs/procedureArtifact" } }, "payloads": { "type": "array", "items": { "$ref": "#/$defs/payloadDescriptor" } }, "procedure_contract_refs": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "procedureArtifact": { "type": "object", "required": ["procedure_id", "artifact_id", "payload_ref", "content_hash", "recorded_at", "reviewed_plan_artifact_id", "reviewed_plan_content_hash", "reviewed_evidence_artifact_id"], "properties": { "procedure_id": { "type": "string" }, "artifact_id": { "$ref": "#/$defs/contentId" }, "payload_ref": { "type": "string" }, "content_hash": { "$ref": "#/$defs/contentId" }, "recorded_at": { "type": "string" }, "reviewed_plan_artifact_id": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] }, "reviewed_plan_content_hash": { "anyOf": [{ "$ref": "#/$defs/rawHash" }, { "type": "null" }] }, "reviewed_evidence_artifact_id": { "anyOf": [{ "$ref": "#/$defs/contentId" }, { "type": "null" }] } }, "additionalProperties": false },
    "payloadDescriptor": { "type": "object", "required": ["payload_id", "parent_record_id", "kind", "content_hash", "raw_size_bytes", "redaction_status", "retention_class"], "properties": { "payload_id": { "type": "string" }, "parent_record_id": { "type": "string" }, "kind": { "type": "string" }, "content_hash": { "$ref": "#/$defs/contentId" }, "raw_size_bytes": { "type": "integer", "minimum": 0 }, "redaction_status": { "type": "string" }, "retention_class": { "type": "string" } }, "additionalProperties": false },
    "routingRecord": { "type": "object", "required": ["record_id", "record_kind", "status", "created_at", "procedure_id", "route_decision_id", "route_class", "policy_version", "binding_version", "binding_profile_id", "context_core_id", "context_manifest_id", "delta_overlay_id", "usage_ref", "changed_surface_classes", "risk_classes", "deterministic_evidence_state", "required_semantic_reviews", "independence_mode", "context_mode", "context_reuse", "request_bytes", "core_bytes", "delta_bytes", "input_tokens", "cached_input_tokens", "output_tokens", "latency_ms", "observed_provider", "observed_model", "observed_reasoning_effort"], "properties": { "record_id": { "type": "string" }, "record_kind": { "type": "string" }, "status": { "type": "string" }, "created_at": { "type": "string" }, "procedure_id": { "type": ["string", "null"] }, "route_decision_id": { "type": ["string", "null"] }, "route_class": { "type": ["string", "null"] }, "policy_version": { "type": ["string", "null"] }, "binding_version": { "type": ["string", "null"] }, "binding_profile_id": { "type": ["string", "null"] }, "context_core_id": { "type": ["string", "null"] }, "context_manifest_id": { "type": ["string", "null"] }, "delta_overlay_id": { "type": ["string", "null"] }, "usage_ref": { "type": ["string", "null"] }, "changed_surface_classes": { "$ref": "#/$defs/stringArray" }, "risk_classes": { "$ref": "#/$defs/stringArray" }, "deterministic_evidence_state": { "type": ["string", "null"] }, "required_semantic_reviews": { "$ref": "#/$defs/stringArray" }, "independence_mode": { "type": ["string", "null"] }, "context_mode": { "type": ["string", "null"] }, "context_reuse": { "type": ["string", "null"] }, "request_bytes": { "type": ["integer", "null"] }, "core_bytes": { "type": ["integer", "null"] }, "delta_bytes": { "type": ["integer", "null"] }, "input_tokens": { "type": ["integer", "null"] }, "cached_input_tokens": { "type": ["integer", "null"] }, "output_tokens": { "type": ["integer", "null"] }, "latency_ms": { "type": ["integer", "null"] }, "observed_provider": { "type": ["string", "null"] }, "observed_model": { "type": ["string", "null"] }, "observed_reasoning_effort": { "type": ["string", "null"] } }, "additionalProperties": false },
    "redaction": { "type": "object", "required": ["applied_before_serialization", "raw_payloads_exported", "redacted_field_count", "strategy"], "properties": { "applied_before_serialization": { "const": true }, "raw_payloads_exported": { "const": false }, "redacted_field_count": { "type": "integer", "minimum": 0 }, "strategy": { "type": "string" } }, "additionalProperties": false },
    "truncation": { "type": "object", "required": ["applied", "omitted_optional_count", "reasons"], "properties": { "applied": { "type": "boolean" }, "omitted_optional_count": { "type": "integer", "minimum": 0 }, "reasons": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false },
    "deliveryRelationship": { "type": "object", "required": ["schema_version", "relationship", "delivered_source_head", "final_reviewed_source_head", "delivered_tree_hash", "final_reviewed_tree_hash", "ancestry", "delivery_fact_id"], "properties": { "schema_version": { "const": 1 }, "relationship": { "enum": ["identity", "merge_contains_exact_tree"] }, "delivered_source_head": { "$ref": "#/$defs/commit" }, "final_reviewed_source_head": { "$ref": "#/$defs/commit" }, "delivered_tree_hash": { "$ref": "#/$defs/commit" }, "final_reviewed_tree_hash": { "$ref": "#/$defs/commit" }, "ancestry": { "enum": ["same_commit", "ancestor"] }, "delivery_fact_id": { "type": "string" } }, "additionalProperties": false },
    "closeout": { "type": "object", "required": ["receipt_id", "status", "created_at", "blocker_count"], "properties": { "receipt_id": { "type": "string" }, "status": { "type": "string" }, "created_at": { "type": "string" }, "blocker_count": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "harvest": { "type": "object", "required": ["harvest_id", "status", "promoted_at", "accepted_count", "discarded_count", "quarantined_count", "redacted_count", "unresolved_count", "project_run_id"], "properties": { "harvest_id": { "type": "string" }, "status": { "const": "promoted" }, "promoted_at": { "type": "string" }, "accepted_count": { "type": "integer", "minimum": 0 }, "discarded_count": { "type": "integer", "minimum": 0 }, "quarantined_count": { "type": "integer", "minimum": 0 }, "redacted_count": { "type": "integer", "minimum": 0 }, "unresolved_count": { "type": "integer", "minimum": 0 }, "project_run_id": { "type": "string" } }, "additionalProperties": false },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  },
  "additionalProperties": false
}
