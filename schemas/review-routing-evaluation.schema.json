{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review routing evaluation bundle",
  "type": "object",
  "required": ["schema_version", "producer_command", "contract_version", "evaluation_id", "evaluation_host_run_instance_id", "source_run_instance_id", "source_lifecycle_status", "source_packet_artifact_id", "source_approved_attempt_id", "evaluation_mode", "policy_version", "binding_version", "candidate_profile_id", "cases", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "producer_command": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "evaluation_host_run_instance_id": {"type": "string", "minLength": 1},
    "source_run_instance_id": {"type": "string", "minLength": 1},
    "source_lifecycle_status": {"enum": ["active", "closed", "harvested", "discarded"]},
    "source_packet_artifact_id": {"type": "string", "minLength": 1},
    "source_approved_attempt_id": {"type": "string", "minLength": 1},
    "evaluation_mode": {"enum": ["shadow", "replay", "canary"]},
    "policy_version": {"type": "string", "minLength": 1},
    "binding_version": {"type": "string", "minLength": 1},
    "candidate_profile_id": {"type": "string", "minLength": 1},
    "canary_authorization_id": {"type": "string", "minLength": 1},
    "canary_invocation_count": {"type": "integer", "minimum": 1, "maximum": 3},
    "canary_closed": {"type": "boolean"},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["case_id", "procedure_id", "pass_kind", "risk_classes", "baseline_attempt_id", "candidate_attempt_id", "baseline_observation_record_id", "candidate_observation_record_id", "candidate_output_hash", "context_core_id", "context_manifest_id", "delta_overlay_id"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "procedure_id": {"enum": ["plan-review", "implementation-review"]},
        "pass_kind": {"type": "string", "minLength": 1},
        "risk_classes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "baseline_attempt_id": {"type": "string", "minLength": 1},
        "candidate_attempt_id": {"type": "string", "minLength": 1},
        "baseline_observation_record_id": {"type": "string", "minLength": 1},
        "candidate_observation_record_id": {"type": "string", "minLength": 1},
        "candidate_output_hash": {"type": "string", "minLength": 1},
        "context_core_id": {"type": "string", "minLength": 1},
        "context_manifest_id": {"type": "string", "minLength": 1},
        "delta_overlay_id": {"type": "string", "minLength": 1}
      }
    }},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
