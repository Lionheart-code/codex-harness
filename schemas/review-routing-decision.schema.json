{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review routing owner decision",
  "type": "object",
  "required": ["schema_version", "producer_command", "decision_id", "run_instance_id", "evaluation_id", "decision", "policy_version", "binding_version", "approver", "reason", "created_at", "state"],
  "properties": {
    "schema_version": {"const": 1},
    "producer_command": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "run_instance_id": {"type": "string", "minLength": 1},
    "evaluation_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["authorize_canary", "promote", "reject", "rollback"]},
    "policy_version": {"type": "string", "minLength": 1},
    "binding_version": {"type": "string", "minLength": 1},
    "previous_policy_version": {"type": "string", "minLength": 1},
    "previous_binding_version": {"type": "string", "minLength": 1},
    "previous_accepted_policy_version": {"type": "string", "minLength": 1},
    "previous_accepted_binding_version": {"type": "string", "minLength": 1},
    "previous_policy_blob_hash": {"type": "string", "minLength": 1},
    "previous_binding_blob_hash": {"type": "string", "minLength": 1},
    "previous_accepted_profiles": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evaluation_content_hash": {"type": "string", "minLength": 1},
    "promotion_gates": {"type": "object"},
    "selector": {"type": "object"},
    "max_invocations": {"type": "integer", "minimum": 1, "maximum": 3},
    "approver": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "state": {"enum": ["canary_authorized", "canary_closed", "source_application_required", "applied", "rejected", "rollback_source_update_required"]}
  },
  "additionalProperties": false
}
